// US: "12/25/2023"
console.log(date.toLocaleDateString('en-US'));
// Germany: "25.12.2023"
console.log(date.toLocaleDateString('de-DE'));
// Japan: "2023/12/25"
console.log(date.toLocaleDateString('ja-JP'));
```

