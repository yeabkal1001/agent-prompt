      '90days': calculateCapacity(projectedUsers['90days']),
      '365days': calculateCapacity(projectedUsers['365days'])
    }
  };
  
  // Alert if capacity insufficient for 90-day forecast
  if (forecast.capacityNeeds['90days'] > currentCapacity * 0.8) {
    alert(`Capacity planning: Need to scale infrastructure by ${forecast.capacityNeeds['90days'] / currentCapacity * 100}% in 90 days`);
  }
  
  return forecast;
}

function calculateCapacity(users) {
  // Estimate infrastructure needs
  const apiServersNeeded = Math.ceil(users / 10000);  // 10K users per server
  const databaseSize = users * 10;  // 10KB per user (estimate)
  const bandwidth = users * 0.1;  // 100KB per user per day (estimate)
  
  return { apiServers: apiServersNeeded, databaseSizeGB: databaseSize / 1024 / 1024, bandwidthGBPerDay: bandwidth / 1024 / 1024 };
}
