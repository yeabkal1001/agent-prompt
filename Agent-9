  const addToCart = http.post('https://shop.example.com/api/cart', JSON.stringify({
    productId: product.id,
    quantity: 1
  }), { headers: { 'Content-Type': 'application/json' } });
  
  check(addToCart, { 'add to cart status 200': (r) => r.status === 200 });
  sleep(10);  // Review cart
  
