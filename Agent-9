**1. CDN Distribution & Edge Caching**

**Multi-Region CDN Configuration (Cloudflare):**
```javascript
// Cloudflare Workers: Edge computing
addEventListener('fetch', event => {
  event.respondWith(handleRequest(event.request));
});

async function handleRequest(request) {
  const url = new URL(request.url);
  const cacheKey = new Request(url.toString(), request);
  const cache = caches.default;
  
  // Try cache first (edge cache, <10ms)
  let response = await cache.match(cacheKey);
  
  if (response) {
    // Cache hit
    return response;
  }
  
  // Cache miss: Fetch from origin
  response = await fetch(request);
  
  // Cache static assets (1 year)
  if (url.pathname.match(/\.(js|css|png|jpg|jpeg|gif|woff2)$/)) {
    const headers = new Headers(response.headers);
    headers.set('Cache-Control', 'public, max-age=31536000, immutable');
    response = new Response(response.body, {
      status: response.status,
      statusText: response.statusText,
      headers: headers
    });
    
    event.waitUntil(cache.put(cacheKey, response.clone()));
  }
  
  return response;
}
```

**Geo-Routing Optimization:**
```javascript
// Route users to nearest region
addEventListener('fetch', event => {
  event.respondWith(handleGeoRouting(event.request));
});

async function handleGeoRouting(request) {
  const country = request.headers.get('CF-IPCountry');  // Cloudflare provides user country
  
  // Route to nearest origin
  const origins = {
    'US': 'https://us.api.example.com',
    'EU': 'https://eu.api.example.com',
    'ASIA': 'https://asia.api.example.com',
    'DEFAULT': 'https://global.api.example.com'
  };
  
  const region = getRegion(country);
  const origin = origins[region] || origins['DEFAULT'];
  
  // Proxy request to regional origin
  const url = new URL(request.url);
  url.hostname = new URL(origin).hostname;
  
  return fetch(new Request(url.toString(), request));
}

function getRegion(country) {
  if (['US', 'CA', 'MX'].includes(country)) return 'US';
  if (['GB', 'DE', 'FR', 'IT', 'ES'].includes(country)) return 'EU';
  if (['CN', 'JP', 'KR', 'IN', 'SG'].includes(country)) return 'ASIA';
  return 'DEFAULT';
}
