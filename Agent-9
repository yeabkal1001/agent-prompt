**3. Inventory Query Performance (High-Frequency Reads)**

**Inventory Caching Strategy:**
```javascript
// Two-tier caching for inventory (hot data)
async function getInventory(productId) {
  // L1 Cache: In-memory (instant, 1-second TTL)
  let inventory = inMemoryCache.get(`inventory:${productId}`);
  if (inventory !== undefined) {
    return inventory;
  }
  
  // L2 Cache: Redis (fast, 10-second TTL)
  inventory = await redis.get(`inventory:${productId}`);
  if (inventory !== null) {
    inMemoryCache.set(`inventory:${productId}`, JSON.parse(inventory), 1);  // 1-second TTL
    return JSON.parse(inventory);
  }
  
  // Cache miss: Query database
  inventory = await db.query('SELECT quantity FROM inventory WHERE product_id = $1', [productId]);
  
  // Populate caches
  await redis.set(`inventory:${productId}`, JSON.stringify(inventory), 'EX', 10);
  inMemoryCache.set(`inventory:${productId}`, inventory, 1);
  
  return inventory;
}

// Invalidate cache on inventory update
async function updateInventory(productId, quantity) {
  await db.query('UPDATE inventory SET quantity = $1 WHERE product_id = $2', [quantity, productId]);
  
  // Invalidate caches
  inMemoryCache.del(`inventory:${productId}`);
  await redis.del(`inventory:${productId}`);
  
  // Optionally: Publish cache invalidation event for distributed systems
  await redis.publish('inventory:invalidate', productId);
}
```

**Optimistic Inventory Reservation:**
```javascript
// Reserve inventory optimistically (reduce lock contention)
async function reserveInventory(productId, quantity) {
  // Optimistic: Assume success, decrement immediately
  const inventory = await getInventory(productId);
  
  if (inventory.quantity < quantity) {
    return { success: false, reason: 'Insufficient inventory' };
  }
  
  // Decrement in database (with optimistic locking)
  const result = await db.query(`
    UPDATE inventory
    SET quantity = quantity - $1, version = version + 1
    WHERE product_id = $2 AND version = $3 AND quantity >= $1
    RETURNING *
  `, [quantity, productId, inventory.version]);
  
  if (result.rowCount === 0) {
    // Conflict: Another request updated inventory
    return { success: false, reason: 'Inventory conflict, retry' };
  }
  
  // Invalidate cache
  await updateInventory(productId, result.rows[0].quantity);
  
  return { success: true };
}
