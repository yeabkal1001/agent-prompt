  // Sign order total to prevent tampering
  const crypto = require('crypto');
  
  function signOrder(order) {
    const data = `${order.id}:${order.userId}:${order.total}:${order.currency}`;
    const signature = crypto.createHmac('sha256', process.env.ORDER_SECRET)
                            .update(data)
                            .digest('hex');
    return signature;
  }
  
  // Verify signature before processing payment
  function verifyOrder(order, signature) {
    const expectedSignature = signOrder(order);
    return crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(expectedSignature));
  }
