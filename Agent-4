// Offline Sync - Conflict Resolution
class OfflineSyncService {
  async sync(userId, clientChanges) {
    const serverState = await db.user_data.where({ userId });
    const conflicts = [];
    
    for (const change of clientChanges) {
      const server = serverState.find(s => s.id === change.id);
      
      if (!server || change.timestamp > server.updated_at) {
        // Client wins (last-write-wins)
        await db.user_data.upsert(change);
      } else if (change.timestamp < server.updated_at) {
        // Server wins
        conflicts.push(server);
      }
    }
    
    return {
      accepted: clientChanges.length - conflicts.length,
      conflicts: conflicts,
      server_state: serverState
    };
  }
}
