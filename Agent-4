```javascript
// Multi-layer security
const security = {
  // 1. Authentication - JWT + refresh tokens
  generateTokens(userId) {
    const accessToken = jwt.sign({ userId }, SECRET, { expiresIn: '15m' });
    const refreshToken = crypto.randomBytes(32).toString('hex');
    redis.setex(`refresh:${refreshToken}`, 2592000, userId); // 30 days
    return { accessToken, refreshToken };
  },
  
  // 2. Authorization - RBAC + ABAC
  async checkPermission(userId, resource, action) {
    const roles = await getUserRoles(userId);
    const permissions = await getRolePermissions(roles);
    
    // Attribute-based: check resource ownership
    if (resource.ownerId === userId) return true;
    
    // Role-based: check explicit permissions
    return permissions.some(p => 
      p.resource === resource.type && 
      p.actions.includes(action)
    );
  },
  
  // 3. Input validation - NEVER trust
  sanitize: {
    sql: (input) => pg.escapeLiteral(input),
    xss: (input) => DOMPurify.sanitize(input),
    nosql: (input) => JSON.parse(JSON.stringify(input)) // Remove $operators
  },
  
  // 4. Rate limiting - distributed
  rateLimiter: new RateLimiterRedis({
    storeClient: redis,
    points: 10, // requests
    duration: 1, // per second
    blockDuration: 60
  }),
  
  // 5. CSRF protection
  csrfToken: () => crypto.randomBytes(32).toString('hex'),
  
  // 6. Encryption at rest
  encrypt: (data) => {
    const iv = crypto.randomBytes(16);
    const cipher = crypto.createCipheriv('aes-256-gcm', KEY, iv);
    return Buffer.concat([iv, cipher.update(data), cipher.final()]);
  }
};
