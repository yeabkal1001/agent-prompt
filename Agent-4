class OrderStateMachine {
  transitions = {
    pending: ['payment_processing', 'cancelled'],
    payment_processing: ['paid', 'payment_failed'],
    payment_failed: ['payment_processing', 'cancelled'],
    paid: ['fulfillment_pending', 'refunded'],
    fulfillment_pending: ['partially_shipped', 'shipped', 'cancelled'],
    partially_shipped: ['shipped'],
    shipped: ['in_transit', 'delivery_failed'],
    in_transit: ['delivered', 'delivery_failed'],
    delivery_failed: ['in_transit', 'return_initiated'],
    delivered: ['return_initiated'],
    return_initiated: ['return_in_transit'],
    return_in_transit: ['refunded'],
    refunded: [],
    cancelled: []
  };
  
  async transition(orderId, toState, reason) {
    const order = await db.orders.where({ id: orderId }).first();
    
    if (!this.transitions[order.status].includes(toState)) {
      throw new Error(`Invalid transition: ${order.status} -> ${toState}`);
    }
    
    await db.transaction(async trx => {
      await trx('orders')
        .where({ id: orderId })
        .update({ status: toState, updated_at: new Date() });
      
      await trx('order_history').insert({
        order_id: orderId,
        from_status: order.status,
        to_status: toState,
        reason: reason,
        timestamp: new Date()
      });
      
      // Trigger side effects
      await this.handleSideEffects(trx, orderId, toState);
    });
  }
  
  async handleSideEffects(trx, orderId, state) {
    switch(state) {
      case 'paid':
        await this.reserveInventory(trx, orderId);
        await this.notifyWarehouse(orderId);
        break;
      case 'cancelled':
        await this.releaseInventory(trx, orderId);
        await this.initiateRefund(orderId);
        break;
      case 'delivered':
        await this.triggerReviewRequest(orderId);
        break;
    }
  }
}

