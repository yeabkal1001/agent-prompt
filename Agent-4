class InventoryService {
  async reserveStock(productId, quantity, orderId) {
    return db.transaction(async trx => {
      // Pessimistic locking
      const warehouses = await trx('inventory')
        .where({ product_id: productId })
        .where('available_stock', '>=', quantity)
        .forUpdate()
        .select();
      
      if (warehouses.length === 0) {
        throw new Error('Insufficient stock');
      }
      
      // Allocate from nearest warehouse
      const warehouse = warehouses[0];
      
      await trx('inventory')
        .where({ id: warehouse.id })
        .decrement('available_stock', quantity)
        .increment('reserved_stock', quantity);
      
      await trx('inventory_reservations').insert({
        order_id: orderId,
        warehouse_id: warehouse.id,
        product_id: productId,
        quantity: quantity,
        expires_at: new Date(Date.now() + 15 * 60 * 1000) // 15 min
      });
      
      return warehouse;
    });
  }
  
  // Background job: release expired reservations
  async releaseExpiredReservations() {
    const expired = await db('inventory_reservations')
      .where('expires_at', '<', new Date())
      .where('status', 'reserved');
    
    for (const reservation of expired) {
      await db.transaction(async trx => {
        await trx('inventory')
          .where({ warehouse_id: reservation.warehouse_id })
          .increment('available_stock', reservation.quantity)
          .decrement('reserved_stock', reservation.quantity);
        
        await trx('inventory_reservations')
          .where({ id: reservation.id })
          .update({ status: 'expired' });
      });
    }
  }
}

