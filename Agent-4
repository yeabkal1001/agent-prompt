      const freshRate = await fetchExchangeRate('USD', targetCurrency);
      await redis.setex(`fx:USD:${targetCurrency}`, 3600, freshRate);
      return priceUSD * freshRate;
    }
    return priceUSD * parseFloat(rate);
  }
  
