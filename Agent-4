// Shared schema with Row-Level Security
/*
-- Enable RLS on all tables
ALTER TABLE orders ENABLE ROW LEVEL SECURITY;

CREATE POLICY tenant_isolation ON orders
  USING (tenant_id = current_setting('app.current_tenant_id')::UUID);

-- Tenant-aware queries (automatic filtering)
SET app.current_tenant_id = '123e4567-e89b-12d3-a456-426614174000';
SELECT * FROM orders; -- Only returns orders for this tenant
*/

class MultiTenantService {
  // Tenant resolution middleware
  async resolveTenant(req, res, next) {
    const subdomain = req.subdomains[0];
    const tenant = await db('tenants')
      .where({ subdomain: subdomain })
      .first();
    
    if (!tenant) return res.status(404).json({ error: 'Tenant not found' });
    
    req.tenantId = tenant.id;
    req.tenant = tenant;
    
    // Set for RLS
    await db.raw('SET app.current_tenant_id = ?', [tenant.id]);
    
    next();
  }
  
  // Per-tenant rate limiting
  getRateLimit(tenantId) {
    return async (req, res, next) => {
      const tenant = await db('tenants').where({ id: tenantId }).first();
      const limit = tenant.plan === 'enterprise' ? 10000 : 1000;
      
      const current = await redis.incr(`ratelimit:${tenantId}:${Date.now()}`);
      if (current > limit) {
        return res.status(429).json({ error: 'Rate limit exceeded' });
      }
      
      next();
    };
  }
  
  // Tenant data isolation verification
  async auditDataIsolation() {
    // Verify no queries leak across tenants
    const leaks = await db.raw(`
      SELECT DISTINCT tenant_id 
      FROM orders 
      WHERE tenant_id != current_setting('app.current_tenant_id')::UUID
    `);
    
    if (leaks.rows.length > 0) {
      logger.critical('DATA LEAK DETECTED', { leaks });
      await this.triggerSecurityIncident('data_isolation_breach');
    }
  }
}

