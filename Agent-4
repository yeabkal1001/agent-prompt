class I18nService {
  async getProduct(productId, locale) {
    const product = await db('products')
      .where({ id: productId })
      .first();
    
    const translation = await db('product_translations')
      .where({ product_id: productId, locale: locale })
      .first();
    
    // Fallback to default locale
    if (!translation) {
      const fallback = await db('product_translations')
        .where({ product_id: productId, locale: 'en-US' })
        .first();
      
      return { ...product, ...fallback, locale_fallback: true };
    }
    
    return { ...product, ...translation };
