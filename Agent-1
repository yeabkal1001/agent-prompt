### Project Type Detection (Run This First)

```bash
# Detect project type before coordination
PROJECT_TYPE="UNKNOWN"

# Check product vision
if grep -qi "mobile\|ios\|android\|react native\|flutter" .jules/pm/product-vision.md 2>/dev/null; then
    PROJECT_TYPE="$PROJECT_TYPE,MOBILE"
fi

if grep -qi "e-commerce\|shopping\|cart\|payment\|checkout\|stripe\|shopify" .jules/pm/product-vision.md 2>/dev/null; then
    PROJECT_TYPE="$PROJECT_TYPE,ECOMMERCE"
fi

if grep -qi "multi-language\|i18n\|localization\|international\|global" .jules/pm/product-vision.md 2>/dev/null; then
    PROJECT_TYPE="$PROJECT_TYPE,I18N"
fi

if grep -qi "enterprise\|multi-tenant\|saas\|b2b" .jules/pm/product-vision.md 2>/dev/null; then
    PROJECT_TYPE="$PROJECT_TYPE,ENTERPRISE"
fi

# Check tech stack
if [ -f ".jules/tech-stack.md" ]; then
    if grep -qi "react-native\|flutter\|swift\|kotlin" .jules/tech-stack.md; then
        PROJECT_TYPE="$PROJECT_TYPE,MOBILE"
    fi
fi

# Check directory structure
if [ -d "src/ios" ] || [ -d "src/android" ] || [ -d "android" ] || [ -d "ios" ]; then
    PROJECT_TYPE="$PROJECT_TYPE,MOBILE"
fi

if [ -d "locales" ] || [ -d "i18n" ] || [ -d "translations" ]; then
    PROJECT_TYPE="$PROJECT_TYPE,I18N"
fi

# Default to WEB if nothing detected
if [ "$PROJECT_TYPE" = "UNKNOWN" ]; then
    PROJECT_TYPE="WEB"
fi

echo "Project Type(s): $PROJECT_TYPE"
```

