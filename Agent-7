// Automated test: Check for missing translations
const enTranslations = require('./locales/en-US.json');
const deTranslations = require('./locales/de-DE.json');

test('German translations complete', () => {
  const enKeys = getAllKeys(enTranslations);
  const deKeys = getAllKeys(deTranslations);
  
  const missingKeys = enKeys.filter(key => !deKeys.includes(key));
