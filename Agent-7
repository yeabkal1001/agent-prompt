    'A': 'Á', 'E': 'É', 'I': 'Í', 'O': 'Ö', 'U': 'Ü',
  };
  
  let pseudo = text.split('').map(char => charMap[char] || char).join('');
  return `[~~${pseudo}~~]`;  // Add padding to simulate text expansion
}

// Test: Pseudo-localized UI should not break
