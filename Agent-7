**TC-SOC2-AVL-001: Database Backup Verification**
```bash
#!/bin/bash
# Verify daily backups exist and are restorable

BACKUP_DIR="/backups/postgres"
TODAY=$(date +%Y-%m-%d)

# Check backup file exists
if [ ! -f "$BACKUP_DIR/db_backup_$TODAY.sql.gz" ]; then
  echo "FAIL: Backup file not found for $TODAY"
  exit 1
fi

# Verify backup is not empty (portable: detect OS)
if [[ "$OSTYPE" == "darwin"* ]]; then
  SIZE=$(stat -f%z "$BACKUP_DIR/db_backup_$TODAY.sql.gz")  # macOS/BSD
else
  SIZE=$(stat -c%s "$BACKUP_DIR/db_backup_$TODAY.sql.gz")  # Linux/GNU
fi
if [ $SIZE -lt 1000000 ]; then  # <1MB suspiciously small
  echo "FAIL: Backup file too small ($SIZE bytes)"
  exit 1
fi

# Test restore to staging DB
gunzip -c "$BACKUP_DIR/db_backup_$TODAY.sql.gz" | psql staging_db
if [ $? -eq 0 ]; then
  echo "PASS: Backup restored successfully"
else
  echo "FAIL: Backup restore failed"
  exit 1
fi
```

