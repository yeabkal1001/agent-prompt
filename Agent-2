```bash
# Score each project type (count keyword matches)
COMPLEX_WEB=$(cat .jules/app-idea.md .jules/pm/product-vision.md | grep -ioE "microservice|distributed|scale|million|users|traffic|api gateway|kubernetes" | wc -l)
MOBILE=$(cat .jules/app-idea.md .jules/pm/product-vision.md | grep -ioE "mobile|ios|android|app store|push notification|offline|native|react native|flutter" | wc -l)
