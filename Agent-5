// Advanced Cart State - Handles inventory, pricing, promotions
// src/stores/useCartStore.ts
import create from 'zustand';
import { persist, subscribeWithSelector } from 'zustand/middleware';

interface CartStore {
  items: CartItem[];
  promotions: Promotion[];
  shippingMethod: ShippingMethod | null;
  
  // Actions
  addItem: (product: Product, quantity: number) => Promise<void>;
  removeItem: (itemId: string) => void;
  updateQuantity: (itemId: string, quantity: number) => Promise<void>;
  applyPromotion: (code: string) => Promise<void>;
  
  // Computed
  subtotal: () => number;
  tax: () => number;
  shipping: () => number;
  discount: () => number;
  total: () => number;
}

export const useCartStore = create<CartStore>()(
  subscribeWithSelector(
    persist(
      (set, get) => ({
        items: [],
        promotions: [],
        shippingMethod: null,
        
        addItem: async (product, quantity) => {
          // Check real-time inventory
          const available = await api.checkInventory(product.id, quantity);
          if (!available) throw new Error('Insufficient inventory');
          
          set((state) => {
            const existing = state.items.find(i => i.productId === product.id);
            if (existing) {
              return {
                items: state.items.map(i =>
                  i.productId === product.id ? { ...i, quantity: i.quantity + quantity } : i
                )
              };
            }
            return {
              items: [...state.items, { id: generateId(), productId: product.id, name: product.name, price: product.price, quantity, image: product.image, addedAt: Date.now() }]
            };
          });
          
          analytics.track('add_to_cart', { product_id: product.id, quantity, price: product.price });
        },
        
        updateQuantity: async (itemId, quantity) => {
          const item = get().items.find(i => i.id === itemId);
          if (!item) return;
          
          const available = await api.checkInventory(item.productId, quantity);
          if (!available) throw new Error('Requested quantity unavailable');
          
          set((state) => ({ items: state.items.map(i => i.id === itemId ? { ...i, quantity } : i) }));
        },
        
        subtotal: () => get().items.reduce((sum, item) => sum + (item.price * item.quantity), 0),
        discount: () => {
          const subtotal = get().subtotal();
          return get().promotions.reduce((sum, promo) => {
            return promo.type === 'percentage' ? sum + (subtotal * promo.value / 100) : sum + promo.value;
          }, 0);
        },
        tax: () => (get().subtotal() - get().discount()) * 0.08,
        shipping: () => get().shippingMethod?.cost || 0,
        total: () => get().subtotal() - get().discount() + get().tax() + get().shipping()
      }),
      { name: 'cart-storage', partialize: (state) => ({ items: state.items }) }
    )
  )
);

