@objc(BiometricAuth)
class BiometricAuth: NSObject {
  @objc
  func authenticate(_ callback: @escaping RCTResponseSenderBlock) {
    let context = LAContext()
    var error: NSError?
    
    if context.canEvaluatePolicy(.deviceOwnerAuthenticationWithBiometrics, error: &error) {
      context.evaluatePolicy(.deviceOwnerAuthenticationWithBiometrics,
                            localizedReason: "Authenticate to access app") { success, error in
        DispatchQueue.main.async {
          if success {
            callback([NSNull(), ["success": true]])
          } else {
            callback([error?.localizedDescription ?? "Auth failed", NSNull()])
          }
        }
      }
    } else {
      callback([error?.localizedDescription ?? "Biometrics unavailable", NSNull()])
    }
  }
}

